Auto_Admin__PORT=3000
Auto_Admin__HOST=localhost

# Режим работы development | production | test
Auto_Admin__NODE_ENV=development
Auto_Admin__LOG_LEVEL=info

# Количество доверенных reverse proxy перед сервером. Для прямого подключения оставьте 0.
Auto_Admin__TRUST_PROXY_HOPS=0

# Разрешённые origins через запятую
Auto_Admin__CORS_ALLOWED_ORIGINS=http://localhost:5173

Auto_Admin__DB_CONNECT_TIMEOUT_MS=5000
Auto_Admin__DB_QUERY_TIMEOUT_MS=30000
Auto_Admin__LOGIN_RATE_LIMIT=10
Auto_Admin__LOGIN_RATE_WINDOW_MS=60000
Auto_Admin__INSTALL_RATE_LIMIT=5
Auto_Admin__INSTALL_RATE_WINDOW_MS=60000
Auto_Admin__AUTH_USER_ATTEMPT_LIMIT=10
Auto_Admin__AUTH_IP_ATTEMPT_LIMIT=100
Auto_Admin__AUTH_IP_USER_ATTEMPT_LIMIT=5
Auto_Admin__AUTH_SHORT_WINDOW_SECONDS=900
Auto_Admin__AUTH_IP_WINDOW_SECONDS=86400
Auto_Admin__LOGIN_ATTEMPT_RETENTION_DAYS=30

# переменные БД (система заполнит сама)
# Auto_Admin__DB_HOST
# Auto_Admin__DB_PORT
# Auto_Admin__DB_DATABASE
# Auto_Admin__DB_USERNAME
# Auto_Admin__DB_PASSWORD

# Сгенерируйте токен командой: openssl rand -hex 32
Auto_Admin__INSTALL_TOKEN=

# Только для integration-тестов. Никогда не указывайте здесь production-БД.
# Auto_Admin__RUN_MYSQL_TESTS=1
# Auto_Admin__TEST_DB_HOST=127.0.0.1
# Auto_Admin__TEST_DB_PORT=3306
# Auto_Admin__TEST_DB_USERNAME=root
# Auto_Admin__TEST_DB_PASSWORD=
